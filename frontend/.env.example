# ==============================================================================
# MediaForge Frontend Environment Configuration
# ==============================================================================
# In local development: Leave blank to use Vite proxy (/api -> http://127.0.0.1:8000)
# In production on Netlify: Set this in Netlify Site Configuration -> Environment Variables
# Example: VITE_API_URL=https://mediaforge-backend.onrender.com/api
VITE_API_URL=
