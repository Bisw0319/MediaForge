# ==============================================================================
# MediaForge - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values.

# Optional Direct SMTP Email Dispatch (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
TARGET_ADMIN_EMAIL=your_email@gmail.com

# Firebase Cloud Configuration (Optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Path to service account json (or place 'firebase_service_account.json' in backend/)
# FIREBASE_CREDENTIALS_PATH=backend/firebase_service_account.json
